<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- core-splashscreen theme for MainActivity only — see docs/MotoNav_TASK7_STAGED_PLAN.md
         stage 2 §3.2(c). postSplashScreenTheme hands back to the app's normal theme once the
         splash dismisses, so nothing else in the manifest needs to change. -->
    <style name="Theme.MotoNav.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.NoActionBar</item>
    </style>
</resources>
